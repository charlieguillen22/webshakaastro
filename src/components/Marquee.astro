---
import { Image } from "astro:assets";

const modules = import.meta.glob(
    "/src/assets/partners/*.{svg,png,jpg,jpeg,webp,avif}",
    { eager: true }
);

// Convierte cada archivo en { src, alt } usando el nombre del archivo como alt
const logos = Object.entries(modules).map(([path, mod]) => ({
    src: mod.default,
    alt: path.split("/").pop().replace(/\.[^.]+$/, "").replace(/[-_]/g, " "),
}));
---

<div class="marquee">
    {[false, true].map((hidden) => (
        <ul class="marquee__group" aria-hidden={hidden ? "true" : undefined}>
            {logos.map((logo) => (
                <li>
                    <Image src={logo.src} alt={hidden ? "" : logo.alt} loading="lazy" />
                </li>
            ))}
        </ul>
    ))}
</div>

<style>
    .marquee {
        --gap: 6rem;
        --duration: 60s;
        display: flex;
        gap: var(--gap);
        overflow: hidden;
        width: 100%;
        /* difuminado en los bordes */
        mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    }

    .marquee__group {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: space-around;
        gap: var(--gap);
        min-width: 100%;
        margin: 0;
        padding: 0;
        list-style: none;
        animation: marquee var(--duration) linear infinite;
    }

    .marquee__group img {
        height: auto;
        width: 100px;
        max-width: none;
        opacity: 0.8;
        transition: opacity 0.3s;
        filter: grayscale(1)
    }

    .marquee__group img:hover {
        opacity: 1;
    }

    .marquee:hover .marquee__group {
        animation-play-state: paused;
    }

    @keyframes marquee {
        to {
            transform: translateX(calc(-100% - var(--gap)));
        }
    }

    @media (max-width: 992px) {
        .marquee {
            --gap: 4rem;
        }

        .marquee__group img {
            width: 90px;
        }
    }

    @media (max-width: 650px) {
        .marquee {
            --gap: 3rem;
        }

        .marquee__group img {
            width: 80px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee__group {
            animation: none;
        }
    }
</style>
---
import { Image } from "astro:assets";
import Button from '../components/Button.astro';

const { title, description, url, heroImage, heroImageAlt = "" } = Astro.props;
---
<div class="swiper-slide">
  <div class="container blogcenter">
    <div class="col-9">
      <div class="wrapper-img-blog">
        {heroImage && (
          <a href={url}><Image src={heroImage} alt={heroImageAlt} class="img-featured-blog-home" /></a>
        )}
      </div>
    </div>
    <div class="col-3">
      <h3 class="title-blog-home"><a href={url}>{title}</a></h3>
      <p>{description}</p>
      <Button href={url} texto="Leer más" icono="andrsrxn:arrow-corner-down-right" />
    </div>
  </div>
</div>
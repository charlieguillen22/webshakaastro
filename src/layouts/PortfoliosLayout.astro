---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import Spacer from '../components/Spacer.astro';
import Button from "../components/Button.astro";

import { slugify } from '../utils/slugify'; // ajusta la ruta según el archivo


const { pageTitle, pageDescription, contexto, diseño, desarrollo, resultado, heroImage, heroImageAlt, tags = [], base = "/portfolio", pubDate, urlWeb } = Astro.props;
const year = pubDate ? pubDate.getUTCFullYear() : "";


---
<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription} heroImage={heroImage}>
  <section class="section-portfolio">
    {heroImage && (
      <Image src={heroImage} alt={heroImageAlt} class="section-portfolio-bg" />
    )}
    <div class="container">
      <div class="col-12">
        <h1 class="title-portfoliolayout">{pageTitle}</h1>
      </div>
      <div class="info-portfoliolayout">
        <div class="col-1">
          <p class="title-info">Año</p>
          <p class="text-info">{year}</p>
        </div>
        <div class="col-2">
          <p class="title-info">Categorías</p>
          <ul class="text-info">
            {tags.map((tag) => (
              <li><a href={`/portfolio/categoria/${slugify(tag)}/`}>{tag}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
  <section class="section-info-portfolio">
    <div class="container">
      <div class="col-12">
        <p class="text-big">{pageDescription}</p>
        <Spacer size="2rem" />
        {urlWeb && (
          <Button href={urlWeb} texto="Ver más" icono="andrsrxn:arrow-corner-down-right" />
        )}
      </div>
    </div>
  </section>
  <section class="nopadding-top">
    <div class="container boxes-portfolio ">
      <div class="col-4 bg-portfolio">
        <h2>Contexto</h2>
        <p>{contexto}</p>
      </div>
      <div class="col-4 bg-portfolio">
        <h2>Diseño</h2>
        <p>{diseño}</p>
      </div>
      <div class="col-4 bg-portfolio">
        <h2>Desarrollo</h2>
        <div class="categories">{desarrollo.length > 0 && (
              <ul class="portfolio-categories">
                  {desarrollo.map((desarrollo) => (
                    <li>{desarrollo}</li>
                  ))}
                </ul>
              )}
            </div>
      </div>
      <div class="col-4 bg-portfolio">
        <h2>Resultado</h2>
        <p>{resultado}</p>
      </div>
      </div>
  </section>
</BaseLayout>
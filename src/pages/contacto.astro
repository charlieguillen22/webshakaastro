---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import gifSurfContact from "../assets/11-2026/gif-surf.gif";
import SocialLinks from "../components/SocialLinks.astro";
import ContactForm from "../components/ContactForm.astro";

const pageTitle = "Contacto";
const pageDescription = "Contacta con nosotros y pide presupuesto de cualquiera de nuestros servicios, o pide más información de lo que necesites."
---
<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription}>
    <section>
        <div class="container">
            <div class="col-5">
                <Image src={gifSurfContact} alt="Hombre en traje haciendo surf" class="img-contact" />
            </div>
            <div class="col-7 doble-col">
                <div class="intern-cols">
                    <div class="col-7">
                        <h3 class="subtitle">¿Hablamos?</h3>
                        <ContactForm />
                    </div>
                    <div class="col-5">
                        <h3 class="subtitle">LLámanos</h3>
                        <p class="text-big">+34 674 255 971</p>
                        <SocialLinks />
                    </div>
                </div>  
                <div class="col-12">
                    <h1 class="title-normal">{pageTitle}</h1>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>    

---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfoliosPortfolio from "../../components/PortfoliosPortfolio.astro";


const pageTitle = "Portfolio";
const pageDescription = "Aquí os dejamos algunos de nuestros trabajos realizados de diseño y desarrollo web, branding, redes sociales";

const portfolios = (await getCollection("portfolio", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription}>
  <section>
    <div class="container">
        <h1 class="title-normal">{pageTitle}</h1>
    </div>
    <div class="container slider-portfolio">
        <PortfoliosPortfolio portfolios={portfolios} />
    </div>
  </section>
</BaseLayout>
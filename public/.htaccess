# ============================================================
# .htaccess - shakagency.es (Astro, sitio estatico)
# Colocar en public/.htaccess para que se copie a dist/ al compilar
# ============================================================

RewriteEngine On

# ------------------------------------------------------------
# 1. Redirecciones 301 de URLs antiguas (WordPress -> Astro)
#    Van primero y apuntan a la URL final (https + sin www),
#    asi se resuelven en un solo salto.
#    NE = no escapar el # de las anclas.
# ------------------------------------------------------------

RewriteRule ^portfolio-shaka-agency/?$ https://shakagency.es/portfolio/ [R=301,L]

RewriteRule ^nuestros-servicios/diseno-web/?$ https://shakagency.es/nuestros-servicios/#diseno-web [R=301,NE,L]
RewriteRule ^nuestros-servicios/(diseno-grafico|merchandising|diseno-carteleria)/?$ https://shakagency.es/nuestros-servicios/#branding [R=301,NE,L]
RewriteRule ^nuestros-servicios/redes-sociales/?$ https://shakagency.es/nuestros-servicios/#redes [R=301,NE,L]

RewriteRule ^blog-marketing-digital/?$ https://shakagency.es/blog/ [R=301,L]

RewriteRule ^wp-content/uploads/2021/01/CATALOGO-DE-SERVICIOS-1\.pdf$ https://shakagency.es/nuestros-servicios/ [R=301,L]

RewriteRule ^portfolio/(pet-reuse-logotipo|ecoclean-pagina-web|pet-reuse-pagina-web|ah-asociacion-de-hosteleros-pagina-web|javi-risoto-trainer-pagina-web|oh-my-crepe-malaga-pagina-web-restaurante)/?$ https://shakagency.es/portfolio/ [R=301,L]

# ------------------------------------------------------------
# 2. Forzar HTTPS y dominio sin www
# ------------------------------------------------------------

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://shakagency.es/$1 [R=301,L]

# ------------------------------------------------------------
# 3. Pagina 404 personalizada (Astro genera 404.html desde src/pages/404.astro)
# ------------------------------------------------------------

ErrorDocument 404 /404.html

# ------------------------------------------------------------
# 4. Cabeceras de seguridad
# ------------------------------------------------------------

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Activar solo cuando compruebes que todo el sitio funciona bien con HTTPS:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ------------------------------------------------------------
# 5. Compresion y cache
# ------------------------------------------------------------

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------
# 6. Ocultar archivos sensibles
# ------------------------------------------------------------

Options -Indexes

<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
